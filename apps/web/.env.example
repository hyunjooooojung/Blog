# Supabase 프로젝트 URL (클라이언트에서도 읽힘 — 공개 가능)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service role 키 — 서버 전용, 절대 브라우저에 노출하지 말 것
SUPABASE_SERVICE_ROLE_KEY=replace-me-service-role-key

# 방문자 해시 salt — visitor_hash = SHA-256(SALT:ip:ua), 서버 전용
# 임의의 긴 문자열로 설정. 변경 시 기존 dedup 데이터가 무효화됨에 주의.
VISITOR_HASH_SALT=replace-me-random-salt
